//! Decodes PNG files covering every colour type, bit depth, interlacing, filter, and DEFLATE
//! block kind.  The fixtures are produced by an independent encoder (Python's zlib); each is
//! checked against the Adler-32 of the RGBA pixels that encoder expected.
@test_module
package Game.PngTests

import Std.Core
import Std.Collections
import Std.Buffer as Buf
import Std.String
import Std.Testing
import Game.Image
import Game.Inflate

record Fixture {
  name: String
  hex: String
  pixels: Int
  adler: Long
}

func hexValue(c: Int): Int {
  if c >= 48 and c <= 57 {
    c - 48
  } else {
    c - 87
  }
}

func unhex(s: String): slice[Byte] {
  val bytes: List[Byte] = newList()
  var i = 0
  while i + 1 < length(s) {
    bytes.add((hexValue(codeUnitAt(s, i)) * 16 + hexValue(codeUnitAt(s, i + 1))).toByte())
    i = i + 2
  }
  bytes.toArray()
}

pub func fixtures(): List[Fixture] {
  val all: List[Fixture] = newList()
  all.add(
