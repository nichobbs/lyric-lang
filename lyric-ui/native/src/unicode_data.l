//! unicode_data.l - Ui.Native.UnicodeData: the Unicode 15.1 character properties the native host's
//! text layout needs, as sorted fixed-width records in strings (docs/67 G10, #8410).
//!
//! Every table is a list of strings holding fixed-width upper-case hex records (the same number in
//! each string but the last), sorted by code point, searched by bisection with `codeUnitAt`, so there is nothing to parse at start-up.  They were generated
//! from ICU 74 (Unicode 15.1) with `u_charDirection` (Bidi_Class), `u_getIntPropertyValue` of
//! `UCHAR_LINE_BREAK`, `UCHAR_EAST_ASIAN_WIDTH`, `UCHAR_EXTENDED_PICTOGRAPHIC` and the general
//! category, `u_charMirror` (Bidi_Mirroring_Glyph) and `u_getBidiPairedBracket`, and are checked
//! against FriBidi and libunibreak by the vectors in the tests.  To update them, regenerate all four
//! from a newer ICU in the same record layout: a small C program loops over U+0000..U+10FFFF, calls the
//! functions above and writes a record whenever the value changes (bidi, line break) or the mirror or
//! bracket property is set; the records are cut into strings of 64 and written as the `val`s below.
//! The generator is not in the repository (a Lyric one is tracked in #8497).
//!
//!   bidi     9 characters: first code point of a run (6 hex), Bidi_Class (3 hex, ICU's UCharDirection)
//!   lineBreak 9 characters: first code point of a run (6 hex), then 3 hex digits holding the ICU
//!            ULineBreak value in bits 0-5, East Asian Width F/W/H in bit 6, Extended_Pictographic
//!            and unassigned in bit 7, general category Pi in bit 8, Pf in bit 9 and Mn or Mc in bit 10
//!   mirror   12 characters: code point (6 hex), its mirror image (6 hex)
//!   bracket  13 characters: code point (6 hex), its pair (6 hex), 1 for an opening and 2 for a
//!            closing bracket
@pure
package Ui.Native.UnicodeData

import Std.Core
import Std.String

val recordsPerChunk: Int = 64

val bidiRuns: slice[String] = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]

val lineBreakRuns: slice[String] = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "0E00800000E01004090E01F0000"]

val mirrorPairs: slice[String] = ["", "", "", "", "", "", ""]

val bracketPairs: slice[String] = ["", ""]

// `digits` hex digits of record `idx` of a table (`recordsPerChunk` records of width `w` in each
// string of it) starting `at` characters into the record.
func hexAt(table: slice[String], w: Int, idx: Int, at: Int, digits: Int): Int {
  val chunk = table[idx / recordsPerChunk]
  val pos = (idx % recordsPerChunk) * w + at
  var v = 0
  var i = 0
  while i < digits {
    val c = codeUnitAt(chunk, pos + i)
    v = v * 16 + (if c >= 65 { c - 55 } else { c - 48 })
    i = i + 1
  }
  v
}

func recordCount(table: slice[String], w: Int): Int {
  (table.length - 1) * recordsPerChunk + table[table.length - 1].length / w
}

// The index of the last record in `table` whose first field is at most `cp`, or -1.
func floorRecord(table: slice[String], w: Int, cp: Int): Int {
  var lo = 0
  var hi = recordCount(table, w) - 1
  var found = -1
  while lo <= hi {
    val mid = (lo + hi) / 2
    if hexAt(table, w, mid, 0, 6) <= cp {
      found = mid
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  found
}

/// The Bidi_Class of `cp` as ICU numbers it: 0 L, 1 R, 2 EN, 3 ES, 4 ET, 5 AN, 6 CS, 7 B, 8 S,
/// 9 WS, 10 ON, 11 LRE, 12 LRO, 13 AL, 14 RLE, 15 RLO, 16 PDF, 17 NSM, 18 BN, 19 FSI, 20 LRI,
/// 21 RLI, 22 PDI.
pub func bidiClassOf(cp: in Int): Int {
  val i = floorRecord(bidiRuns, 9, cp)
  if i < 0 {
    0
  } else {
    hexAt(bidiRuns, 9, i, 6, 3)
  }
}

/// The packed line-break value of `cp` (see the module comment): the ICU ULineBreak value in bits
/// 0-5 plus the flags above it.
pub func lineBreakValueOf(cp: in Int): Int {
  val i = floorRecord(lineBreakRuns, 9, cp)
  if i < 0 {
    0
  } else {
    hexAt(lineBreakRuns, 9, i, 6, 3)
  }
}

/// The character that is `cp` seen in a mirror (a left parenthesis for a right one), or `cp`.
pub func mirrorOf(cp: in Int): Int {
  val i = floorRecord(mirrorPairs, 12, cp)
  if i >= 0 and hexAt(mirrorPairs, 12, i, 0, 6) == cp {
    hexAt(mirrorPairs, 12, i, 6, 6)
  } else {
    cp
  }
}

/// 1 when `cp` is an opening bracket, 2 for a closing bracket, 0 otherwise.
pub func bracketTypeOf(cp: in Int): Int {
  val i = floorRecord(bracketPairs, 13, cp)
  if i >= 0 and hexAt(bracketPairs, 13, i, 0, 6) == cp {
    hexAt(bracketPairs, 13, i, 12, 1)
  } else {
    0
  }
}

/// The bracket paired with `cp`, or `cp` when it is not a bracket.
pub func pairedBracketOf(cp: in Int): Int {
  val i = floorRecord(bracketPairs, 13, cp)
  if i >= 0 and hexAt(bracketPairs, 13, i, 0, 6) == cp {
    hexAt(bracketPairs, 13, i, 6, 6)
  } else {
    cp
  }
}
