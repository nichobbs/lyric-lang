# What lyric bindgen binds from <SDL3/SDL.h> (SDL 3.4).  Regenerate with (from lyric-window/,
# with SDL3's headers reachable through pkg-config or -I):
#   lyric bindgen native/sdl_bindings.h --package Window.Kernel.Sdl --allow native/sdl.allow \
#     --library SDL3 -o src/_kernel/sdl.l -I <SDL3 include dir>
