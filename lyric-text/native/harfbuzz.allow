# What lyric bindgen binds from HarfBuzz: buffers, shaping and the FreeType font bridge.  Regenerate
# both variants with (from lyric-text/):
#   lyric bindgen native/harfbuzz_bindings.h --package Text.Kernel.Harfbuzz --allow native/harfbuzz.allow \
#     --library harfbuzz -o src/_kernel/harfbuzz.l --cfg 'not(target_os = "windows")' \
#     -I <harfbuzz include dir> -I <freetype2 include dir>
#   lyric bindgen native/harfbuzz_bindings.h --package Text.Kernel.Harfbuzz --allow native/harfbuzz.allow \
#     --library harfbuzz -o src/_kernel/harfbuzz_windows.l --cfg 'target_os = "windows"' \
#     --triple x86_64-pc-windows-msvc -I <harfbuzz include dir> -I <freetype2 include dir>
# (the Windows one needs the MSVC and Windows SDK headers: a Windows host, or INCLUDE naming them).
hb_buffer_create
hb_buffer_destroy
hb_buffer_add_utf8
hb_buffer_set_direction
hb_buffer_guess_segment_properties
hb_buffer_get_length
hb_buffer_get_glyph_infos
hb_buffer_get_glyph_positions
hb_shape
hb_ft_font_create_referenced
hb_ft_font_set_load_flags
hb_font_destroy
