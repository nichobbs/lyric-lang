//! wide_local_slot_self_test.l — regression test for #7822: MSIL lowering
//! emitted the short-form `ldloca.s` / `ldarga.s` / `starg.s` for every
//! `MLdloca` / `MLdarga` / `MStarg`, regardless of the slot index. The
//! short form carries a one-byte operand, so in a method with more than 256
//! locals every address-of-local for slot >= 256 silently wrapped to
//! `slot & 0xFF` and addressed an unrelated local — undefined behaviour at
//! runtime (AccessViolationException, DataMisalignedException, or a garbage
//! EntryPointNotFoundException depending on layout and host).
//!
//! It is easiest to hit in an `async func`: every `val` is hoisted into the
//! state machine's `MoveNext`, and the awaiter local is allocated after them,
//! so `IsCompleted` / `GetResult` (both called through `ldloca`) ran against
//! whichever local sat at `slot & 0xFF`. Fixed by routing all three through
//! width-aware emitters (`emitLdloca` / `emitLdarga` / `emitStarg` in
//! `lyric-compiler/msil/opcodes.l`, mirroring `emitLdloc` / `emitStloc`),
//! plus an encoder-level guard that panics on any short-form index > 255
//! instead of truncating it.
//!
//! MSIL-only bug (the JVM backend's local-slot encoding is separate), so
//! this reproduces only on `--target dotnet`.
//! Imports only `Std.*`.
@test_module
package Lyric.WideLocalSlotSelfTest

import Std.Core
import Std.Task
import Std.Testing

pub record Box {
  pub var v: String = ""
}

async func produce(): Box {
  await Std.Task.delay(20)
  Box(v = "hello")
}

