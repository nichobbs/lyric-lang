      }
      if (to.node) {
        if (from.node.type === 'file' && to.node.type === 'dir') return ERRNO_ISDIR;
        if (from.node.type === 'dir' && to.node.type !== 'dir') return ERRNO_NOTDIR;
        if (to.node.type === 'dir' && to.node.children.size > 0) return ERRNO_NOTEMPTY;
      }
      from.parent.children.delete(from.name);
      to.parent.children.set(to.name, from.node);
      from.node.parent = to.parent;
      fs.touch(from.parent);
      fs.touch(to.parent);
      return 0;
    },
    path_filestat_get(dirFd, flags, pathPtr, pathLen, outPtr) {
      const base = dirOf(dirFd);
      if (!base) return ERRNO_BADF;
      const r = fs.resolve(base.node, readPath(pathPtr, pathLen));
      if (r.errno) return r.errno;
      if (!r.node) return ERRNO_NOENT;
      if (r.mustDir && r.node.type !== 'dir') return ERRNO_NOTDIR;
      writeStat(outPtr, r.node);
      return 0;
    },
    path_filestat_set_times(dirFd, flags, pathPtr, pathLen, atim, mtim, fstFlags) {
      const base = dirOf(dirFd);
      if (!base) return ERRNO_BADF;
      const r = fs.resolve(base.node, readPath(pathPtr, pathLen));
      if (r.errno) return r.errno;
      if (!r.node) return ERRNO_NOENT;
      applyTimes(r.node, atim, mtim, fstFlags);
      return 0;
    },
  };
}

/**
 * Instantiate a Lyric module.
 *
 * @param source  ArrayBuffer, URL, Response (or promise of one) or a
 *                WebAssembly.Module; defaults to the `.wasm` next to this file.
 * @param options { stdout, stderr, stdin, args, env, files, imports }
 *                stdout/stderr receive raw text chunks (default: console.log /
 *                console.error per line); stdin() returns a string,
 *                Uint8Array or null for end of input.
 *                files seeds the in-memory filesystem behind the preopened "/"
 *                ({ "/path": string | Uint8Array } or a Map); the instance's
 *                `files` member reads it back (read, readText, write, mkdir,
 *                list, exists, snapshot).
 */
const HTTP_BODY_LIMIT = 10 * 1024 * 1024;

// The default `std.http.fetch` (the host import behind the module-shape
// `Std.Http` kernel): request fields in, one reply String out.  Every failure,
// including a body over the size cap, is an `error` reply and never a rejection,
// because a rejected host promise panics the awaiting Lyric code.
async function defaultStdHttpFetch(method, url, headerLines, contentType, body, hasBody, followRedirects) {
  try {
    if (typeof fetch !== 'function') return 'error\nthis host has no global fetch (pass options.imports["std.http"].fetch)';
    const headers = new Headers();
    for (const line of headerLines.split('\n')) {
      const colon = line.indexOf(':');
      if (colon > 0) headers.append(line.slice(0, colon), line.slice(colon + 1).trim());
    }
    if (hasBody && contentType.length > 0) headers.set('Content-Type', contentType);
    const response = await fetch(url, {
      method,
      headers,
      body: hasBody ? body : undefined,
      redirect: followRedirects ? 'follow' : 'manual',
    });
    if (response.type === 'opaqueredirect') {
      return 'error\nthe request was redirected and redirects are disabled (a browser hides the redirect response)';
    }
    const chunks = [];
    let total = 0;
    if (response.body) {
      const reader = response.body.getReader();
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        total += value.length;
        if (total > HTTP_BODY_LIMIT) {
          await reader.cancel();
          return 'error\nthe response body exceeds the ' + HTTP_BODY_LIMIT + " byte limit";
        }
        chunks.push(value);
      }
    }
    const bytes = new Uint8Array(total);
    let at = 0;
    for (const c of chunks) {
      bytes.set(c, at);
      at += c.length;
    }
    let binary = '';
    for (let i = 0; i < bytes.length; i += 0x8000) {
      binary += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
    }
    let head = 'ok\n' + response.status + '\n';
    response.headers.forEach((value, name) => {
      head += name + ': ' + value.replace(/[\r\n]+/g, ' ') + '\n';
    });
    return head + '\n' + btoa(binary);
  } catch (e) {
    return 'error\n' + (e && e.message ? e.message : String(e));
  }
}

// Host-import modules the glue implements itself; `options.imports` overrides any member.
const BUILTIN_HOST = { 'std.http': { fetch: defaultStdHttpFetch } };

export async function instantiate(source, options = {}) {
  const module = await loadModule(source);
  const sinks = {
    1: options.stdout ? { write: options.stdout, flush() {} } : lineSink((l) => console.log(l)),
    2: options.stderr ? { write: options.stderr, flush() {} } : lineSink((l) => console.error(l)),
  };
  const decoders = { 1: new TextDecoder(), 2: new TextDecoder() };
  const env = options.env || {};
  let memory = null;
  let stdinBuffer = new Uint8Array(0);
  const view = () => new DataView(memory.buffer);
  const bytes = () => new Uint8Array(memory.buffer);
  const memfs = new MemoryFs(options.files);
  const fsw = fsWasiImports(memfs, view, bytes);

  function stringList(items) {
    const encoded = items.map((s) => utf8Encoder.encode(s + '\0'));
    return { encoded, total: encoded.reduce((n, e) => n + e.length, 0) };
  }
  function writeStringList(list, ptrs, buf) {
    const dv = view();
    const mem = bytes();
    let at = buf;
    list.encoded.forEach((e, i) => {
      dv.setUint32(ptrs + i * 4, at, true);
      mem.set(e, at);
      at += e.length;
    });
  }

  const wasi = {
    args_sizes_get(argcPtr, sizePtr) {
      const l = stringList(options.args || []);
      view().setUint32(argcPtr, l.encoded.length, true);
      view().setUint32(sizePtr, l.total, true);
      return 0;
    },
    args_get(ptrs, buf) {
      writeStringList(stringList(options.args || []), ptrs, buf);
      return 0;
    },
    environ_sizes_get(countPtr, sizePtr) {
      const l = stringList(Object.entries(env).map(([k, v]) => k + '=' + v));
      view().setUint32(countPtr, l.encoded.length, true);
      view().setUint32(sizePtr, l.total, true);
      return 0;
    },
    environ_get(ptrs, buf) {
      writeStringList(stringList(Object.entries(env).map(([k, v]) => k + '=' + v)), ptrs, buf);
      return 0;
    },
    clock_res_get(id, resPtr) {
      view().setBigUint64(resPtr, 1000n, true);
      return 0;
    },
    clock_time_get(id, precision, timePtr) {
      let ns;
      if (id === 0) {
        ns = BigInt(Math.round((performance.timeOrigin + performance.now()) * 1000)) * 1000n;
      } else {
        ns = BigInt(Math.round(performance.now() * 1e6));
      }
      view().setBigUint64(timePtr, ns, true);
      return 0;
    },
    random_get(buf, len) {
      const mem = bytes();
      for (let off = 0; off < len; off += 65536) {
        crypto.getRandomValues(mem.subarray(buf + off, buf + Math.min(len, off + 65536)));
      }
      return 0;
    },
    fd_write(fd, iovs, iovsLen, writtenPtr) {
      if (fd > 2) return fsw.fd_write(fd, iovs, iovsLen, writtenPtr);
      const sink = sinks[fd];
      if (!sink) return ERRNO_BADF;
      const dv = view();
      const mem = bytes();
      let total = 0;
      for (let i = 0; i < iovsLen; i++) {
        const ptr = dv.getUint32(iovs + i * 8, true);
        const len = dv.getUint32(iovs + i * 8 + 4, true);
        const text = decoders[fd].decode(mem.subarray(ptr, ptr + len), { stream: true });
        if (text.length > 0) sink.write(text);
        total += len;
      }
      dv.setUint32(writtenPtr, total, true);
      return 0;
    },
    fd_read(fd, iovs, iovsLen, readPtr) {
      if (fd > 2) return fsw.fd_read(fd, iovs, iovsLen, readPtr);
      if (fd !== 0) return ERRNO_BADF;
      const dv = view();
      const mem = bytes();
      let total = 0;
      for (let i = 0; i < iovsLen; i++) {
        const ptr = dv.getUint32(iovs + i * 8, true);
        const len = dv.getUint32(iovs + i * 8 + 4, true);
        if (stdinBuffer.length === 0 && options.stdin) {
          const next = options.stdin();
          if (typeof next === 'string') stdinBuffer = utf8Encoder.encode(next);
          else if (next) stdinBuffer = next;
        }
        const n = Math.min(len, stdinBuffer.length);
        mem.set(stdinBuffer.subarray(0, n), ptr);
        stdinBuffer = stdinBuffer.subarray(n);
        total += n;
        if (n < len) break;
      }
      dv.setUint32(readPtr, total, true);
      return 0;
    },
    fd_close(fd) {
      return fd <= 2 ? 0 : fsw.fd_close(fd);
    },
    fd_seek(fd, offset, whence, outPtr) {
      return fd <= 2 ? ERRNO_SPIPE : fsw.fd_seek(fd, offset, whence, outPtr);
    },
    fd_fdstat_get(fd, ptr) {
      if (fd > 2) return fsw.fd_fdstat_get(fd, ptr);
      const dv = view();
      dv.setUint8(ptr, 2); // filetype: character device
      dv.setUint16(ptr + 2, 0, true);
      dv.setBigUint64(ptr + 8, 0xffffffffffffffffn, true);
      dv.setBigUint64(ptr + 16, 0xffffffffffffffffn, true);
      return 0;
    },
    // Only clock subscriptions are supported (that is what nanosleep and the
    // scheduler's idle wait use).  A blocking wait cannot yield to the event
    // loop, so it uses Atomics.wait where the host allows it (workers, node)
    // and spins otherwise; prefer an async export, which never blocks.
    poll_oneoff(subsPtr, eventsPtr, nsubs, neventsPtr) {
      const dv = view();
      let wakeAt = Infinity;
      const clockSubs = [];
      for (let i = 0; i < nsubs; i++) {
        const base = subsPtr + i * 48;
        if (dv.getUint8(base + 8) !== 0) return ERRNO_NOSYS;
        const clockId = dv.getUint32(base + 16, true);
        const timeout = dv.getBigUint64(base + 24, true);
        const absolute = (dv.getUint16(base + 40, true) & 1) === 1;
        let deadlineMs;
        if (absolute) {
          const nowNs = clockId === 0
            ? BigInt(Math.round((performance.timeOrigin + performance.now()) * 1000)) * 1000n
            : BigInt(Math.round(performance.now() * 1e6));
          deadlineMs = performance.now() + Number(timeout - nowNs) / 1e6;
        } else {
          deadlineMs = performance.now() + Number(timeout) / 1e6;
        }
        wakeAt = Math.min(wakeAt, deadlineMs);
        clockSubs.push(dv.getBigUint64(base, true));
      }
      const waitMs = wakeAt - performance.now();
      if (waitMs > 0) blockFor(waitMs, wakeAt);
      clockSubs.forEach((userdata, i) => {
        const ev = eventsPtr + i * 32;
        dv.setBigUint64(ev, userdata, true);
        dv.setUint16(ev + 8, 0, true);
        dv.setUint8(ev + 10, 0);
      });
      dv.setUint32(neventsPtr, clockSubs.length, true);
      return 0;
    },
    sched_yield() {
      return 0;
    },
    proc_exit(code) {
      throw new LyricExit(code);
    },
  };

  // The stdio-aware calls above delegate to the filesystem for fds past 2; the rest are only about files.
  for (const [name, fn] of Object.entries(fsw)) {
    if (!(name in wasi)) wasi[name] = fn;
  }

  const imports = {};
  for (const imp of WebAssembly.Module.imports(module)) {
    if (!imports[imp.module]) imports[imp.module] = {};
    if (imp.module === WASI_NAMESPACE) {
      imports[imp.module][imp.name] = wasi[imp.name] || (() => ERRNO_NOSYS);
    }
  }
  // Host imports declared with `@wasmImport("module")`: the JS function the host
  // passes in `options.imports[module][name]` receives decoded values (a String
  // as a JS string, a Long as a bigint) and returns a decoded result; these
  // wrappers lower and lift around it.  Names not declared that way are raw wasm
  // imports and pass through unchanged.
  const hostFns = Object.assign({}, options.imports || {});
  for (const [mod, members] of Object.entries(BUILTIN_HOST)) {
    hostFns[mod] = Object.assign({}, members, hostFns[mod] || {});
  }
  // Host imports from an NPM package (`@wasmImport("npm:<package>")`) are
  // satisfied by importing the package unless the caller supplies the module.
  for (const [mod, load] of Object.entries(LYRIC_NPM)) {
    if (hostFns[mod]) continue;
    try {
      const ns = await load();
      // A CommonJS package's named exports are only those Node's static scan
      // finds; the rest live on `default` (module.exports), so look there too.
      hostFns[mod] = new Proxy(ns, {
        get(target, key) {
          if (key in target) return target[key];
          const dflt = target.default;
          if (dflt === null || (typeof dflt !== 'object' && typeof dflt !== 'function')) return undefined;
          const member = dflt[key];
          // Called as `require(pkg).name(...)` would be, so `this` is module.exports.
          return typeof member === 'function' ? member.bind(dflt) : member;
        },
      });
    } catch (e) {
      throw new Error('cannot load the NPM package behind host import ' + mod + ' (run `lyric restore`, or pass it in options.imports): ' + e.message);
    }
  }
  const declared = new Set(LYRIC_IMPORTS.map((imp) => imp.module + '\u0000' + imp.name));
  const missingHost = [];
  for (const imp of LYRIC_IMPORTS) {
    const fn = hostFns[imp.module] && hostFns[imp.module][imp.name];
    if (typeof fn !== 'function') {
      missingHost.push(imp.module + '.' + imp.name);
      continue;
    }
    if (!imports[imp.module]) imports[imp.module] = {};
    imports[imp.module][imp.name] = (...wasmArgs) => {
      const decoded = imp.params.map((kind, i) => liftHostArg(kind, wasmArgs[i]));
      if (imp.ret.startsWith('Task:')) {
        return startHostTask(imp.ret.slice(5), () => fn(...decoded));
      }
      return lowerHostResult(imp.ret, fn(...decoded));
    };
  }
  if (missingHost.length > 0) {
    throw new Error('missing host import' + (missingHost.length > 1 ? 's' : '') + ' ' +
      missingHost.join(', ') + ' (pass ' + (missingHost.length > 1 ? 'them' : 'it') + ' in options.imports)');
  }
  for (const [ns, members] of Object.entries(options.imports || {})) {
    for (const [name, value] of Object.entries(members)) {
      if (!declared.has(ns + '\u0000' + name)) {
        imports[ns] = Object.assign(imports[ns] || {}, { [name]: value });
      }
    }
  }
  for (const imp of WebAssembly.Module.imports(module)) {
    if (imp.module !== WASI_NAMESPACE && !(imports[imp.module] && imports[imp.module][imp.name])) {
      throw new Error('missing host import ' + imp.module + '.' + imp.name +
        ' (pass it in options.imports)');
    }
  }

  const instance = await WebAssembly.instantiate(module, imports);
  const raw = instance.exports;
  memory = raw.memory;
  if (typeof raw.lyric_wasm_abi_version !== 'function' || raw.lyric_wasm_abi_version() !== LYRIC_ABI_VERSION) {
    throw new Error('this glue was generated for lyric wasm ABI ' + LYRIC_ABI_VERSION +
      ' but the module reports ' + (raw.lyric_wasm_abi_version ? raw.lyric_wasm_abi_version() : 'none'));
  }
  const readString = (strPtr) => {
    const len = raw.lyric_wasm_string_len(strPtr);
    const data = raw.lyric_wasm_string_data(strPtr);
    return new TextDecoder().decode(new Uint8Array(memory.buffer, data, len));
  };
  const newString = (text) => {
    const enc = utf8Encoder.encode(text);
    const buf = raw.lyric_wasm_alloc(enc.length);
    new Uint8Array(memory.buffer, buf, enc.length).set(enc);
    const s = raw.lyric_wasm_string_new(buf, enc.length);
    raw.lyric_wasm_free(buf);
    return s;
  };

  // Host imports: a wasm value to the JS value the host function receives, and
  // the host's result back to a wasm value (a String result is a fresh Lyric
  // String the calling code then owns).
  function liftHostArg(kind, value) {
    switch (kind) {
      case 'Int': return value | 0;
      case 'Byte': return value & 0xff;
      case 'Long': return value;
      case 'Bool': return value !== 0;
      case 'Float': case 'Double': return value;
      case 'String': return readString(value);
      default: throw new Error('unsupported host parameter kind ' + kind);
    }
  }
  function lowerHostResult(kind, value) {
    switch (kind) {
      case 'Unit': return undefined;
      case 'Int': return value | 0;
      case 'Byte': return value & 0xff;
      case 'Long': return BigInt.asIntN(64, BigInt(value));
      case 'Bool': return value ? 1 : 0;
      case 'Float': return Math.fround(value);
      case 'Double': return +value;
      case 'String': return newString(String(value));
      default: throw new Error('unsupported host result kind ' + kind);
    }
  }

  const lowerArg = (kind, value, owned) => {
    switch (kind) {
      case 'Int': return value | 0;
      case 'Byte': return value & 0xff;
      case 'Long': return BigInt.asIntN(64, BigInt(value));
      case 'Bool': return value ? 1 : 0;
      case 'Float': return Math.fround(value);
      case 'Double': return +value;
      case 'String': {
        const s = newString(String(value));
        owned.push(s);
        return s;
      }
      default: throw new Error('unsupported parameter kind ' + kind);
    }
  };
  const liftResult = (kind, value) => {
    switch (kind) {
      case 'Unit': return undefined;
      case 'Int': return value | 0;
      case 'Byte': return value & 0xff;
      case 'Long': return value;
      case 'Bool': return value !== 0;
      case 'Float': case 'Double': return value;
      case 'String': {
        try {
          return readString(value);
        } finally {
          raw.lyric_wasm_release(value);
        }
      }
      default: throw new Error('unsupported result kind ' + kind);
    }
  };

  const lyric = { raw, memory, files: memfs.api(), flush() { sinks[1].flush(); sinks[2].flush(); } };

  // A finished task's 64-bit result slot, decoded the way the native backend
  // stored it (Int sign-extended, Float in the low 32 bits, Double as its bits,
  // a String as its pointer).  A String result stays owned by the task, so it is
  // copied out before the caller releases the task.
  const liftSlot = (kind, slot) => {
    switch (kind) {
      case 'Unit': return undefined;
      case 'Int': return Number(BigInt.asIntN(32, slot));
      case 'Byte': return Number(slot & 0xffn);
      case 'Bool': return (slot & 0xffffffffn) !== 0n;
      case 'Long': return BigInt.asIntN(64, slot);
      case 'Float': {
        const dv = new DataView(new ArrayBuffer(4));
        dv.setUint32(0, Number(slot & 0xffffffffn), true);
        return dv.getFloat32(0, true);
      }
      case 'Double': {
        const dv = new DataView(new ArrayBuffer(8));
        dv.setBigUint64(0, BigInt.asUintN(64, slot), true);
        return dv.getFloat64(0, true);
      }
      case 'String': return readString(Number(slot & 0xffffffffn));
      default: throw new Error('unsupported result kind ' + kind);
    }
  };

  // Drive the scheduler from host timers until `task` completes.  A call that is
  // waiting on a host operation (poll returns -2) has no timer: finishing the
  // operation re-runs every active step through `kickScheduler`.
  const activeSteps = new Set();
  const kickScheduler = () => {
    if (activeSteps.size === 0) {
      // No exported call is waiting, but a detached task may still be ready.
      try { raw.lyric_wasm_poll(); } catch (e) { console.error(e); }
      return;
    }
    for (const step of [...activeSteps]) step();
  };
  const settle = (task, kind, resolve, reject) => {
    let timer = null;
    const done = () => {
      activeSteps.delete(step);
      if (timer !== null) { clearTimeout(timer); timer = null; }
    };
    const step = () => {
      if (timer !== null) { clearTimeout(timer); timer = null; }
      try {
        const wait = Number(raw.lyric_wasm_poll());
        if (raw.lyric_task_is_complete(task)) {
          done();
          try {
            resolve(liftSlot(kind, raw.lyric_task_result(task)));
          } finally {
            raw.lyric_wasm_release(task);
          }
        } else if (wait === -2) {
          // Waiting on a host operation: its completion calls kickScheduler.
        } else if (wait < 0) {
          done();
          reject(new Error('deadlock: the async call can never complete (no ready tasks, no timers)'));
        } else {
          timer = setTimeout(step, wait);
        }
      } catch (e) {
        done();
        reject(e);
      }
    };
    activeSteps.add(step);
    step();
  };

  // A host import that returns `Task[T]`: hand the wasm caller a pending task,
  // run the host function, and finish the task from its promise.  A rejection
  // fails the task, which panics the awaiting Lyric code with the message.
  function finishHostTask(task, kind, value) {
    switch (kind) {
      case 'Unit': raw.lyric_wasm_host_finish_i32(task, 0); break;
      case 'Int': raw.lyric_wasm_host_finish_i32(task, value | 0); break;
      case 'Byte': raw.lyric_wasm_host_finish_i32(task, value & 0xff); break;
      case 'Bool': raw.lyric_wasm_host_finish_i32(task, value ? 1 : 0); break;
      case 'Long': raw.lyric_wasm_host_finish_i64(task, BigInt.asIntN(64, BigInt(value))); break;
      case 'Float': raw.lyric_wasm_host_finish_f32(task, Math.fround(value)); break;
      case 'Double': raw.lyric_wasm_host_finish_f64(task, +value); break;
      case 'String': raw.lyric_wasm_host_finish_string(task, newString(String(value))); break;
      default: throw new Error('unsupported host task result kind ' + kind);
    }
  }
  function failHostTask(task, error) {
    const text = error && error.message ? error.message : String(error);
    raw.lyric_wasm_host_fail(task, newString('host import failed: ' + text));
  }
  function startHostTask(kind, call) {
    const task = raw.lyric_wasm_host_task_new();
    let promise;
    try {
      promise = Promise.resolve(call());
    } catch (e) {
      promise = Promise.reject(e);
    }
    promise.then((value) => {
      try {
        finishHostTask(task, kind, value);
      } catch (e) {
        // Only fail a task the finish call did not already complete.
        if (!raw.lyric_task_is_complete(task)) failHostTask(task, e);
      }
      kickScheduler();
    }, (error) => {
      failHostTask(task, error);
      kickScheduler();
    });
    return task;
  }

  for (const ex of LYRIC_EXPORTS) {
    const fn = raw[ex.wasm];
    if (typeof fn !== 'function') continue;
    if (ex.async) {
      lyric[ex.js] = (...args) => new Promise((resolve, reject) => {
        if (args.length !== ex.params.length) {
          reject(new TypeError(ex.js + ' takes ' + ex.params.length + ' argument(s), got ' + args.length));
          return;
        }
        // String arguments stay alive until the task completes: the coroutine may
        // read them after its first suspension.
        const owned = [];
        const releaseArgs = () => { for (const s of owned) raw.lyric_wasm_release(s); };
        let task;
        try {
          task = fn(...ex.params.map((kind, i) => lowerArg(kind, args[i], owned)));
        } catch (e) {
          releaseArgs();
          reject(e);
          return;
        }
        settle(task, ex.ret, (v) => { releaseArgs(); resolve(v); }, (e) => { releaseArgs(); reject(e); });
      });
      continue;
    }
    lyric[ex.js] = (...args) => {
      if (args.length !== ex.params.length) {
        throw new TypeError(ex.js + ' takes ' + ex.params.length + ' argument(s), got ' + args.length);
      }
      const owned = [];
      try {
        const lowered = ex.params.map((kind, i) => lowerArg(kind, args[i], owned));
        return liftResult(ex.ret, fn(...lowered));
      } finally {
