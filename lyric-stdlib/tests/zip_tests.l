//! Std.Zip tests: raw DEFLATE streams and archives written by Python's zlib and
//! zipfile (generated fixtures), CRC-32 vectors, round trips through the writer,
//! and the hostile-input checks (limits, duplicates, corruption, truncation).
package Std.Zip.Tests

import Std.Core
import Std.Collections
import Std.Encoding
import Std.Testing
import Std.Zip

func hex(s: in String): slice[Byte] {
  match tryDecodeHex(s) {
    case Some(b) -> b
    case None -> panic("bad hex in test data")
  }
}

func bytesEq(a: in slice[Byte], b: in slice[Byte]): Bool = encodeHex(a) == encodeHex(b)

