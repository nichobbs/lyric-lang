//! tests/plugin_fixtures/greeter_component.l — a plugin written with the D207
//! annotations and built as a component, for `plugin_component_e2e_tests.l`.
//! `scripts/ci/plugin-component-e2e.sh` packs it with `lyric plugin pack
//! --targets component`, so everything the host meets is generated by
//! `Lyric.PluginExpand` (docs/69 §9.3, D232): the `plugin-describe`,
//! `plugin-attach`, `plugin-methods` and `plugin-type-hints` exports, one
//! export per point method (`greeter-greet`, ...), the capability imports
//! (`fixture-api-secrets`, `fixture-api-net`) with their generated
//! `SecretsCallErrorWire`, `SecretsPeekCallErrorWire` (a `Unit` error, the
//! bare `app` case) and `NetCallErrorWire` variants, and the clients the
//! record holds.
//!
//! The point and capabilities are declared in the plugin's own package, so
//! their ids are `Fixture.Api.Greeter`, `Fixture.Api.Secrets` and
//! `Fixture.Api.Net`, as the host suite declares them.
package Fixture.Api

import Std.Core
import Std.Collections
import Std.String as Str
import Std.Plugin

/// A union result: `Circle(radius)` or `Named(label)`.
pub union Shape {
  case Circle(radius: Double)
  case Named(label: String)
}

pub exposed record SecretsGrant {
  keys: List[String]
}

@capability(grant = SecretsGrant)
pub interface Secrets {
  func read(key: in String): Result[String, String]
  func peek(key: in String): Result[Bool, Unit]
  func describe(shape: in Shape, tags: in Map[String, Int]): Result[String, String]
}

@capability
pub interface Net {
  func fetch(url: in String): Result[String, String]
}

pub record GreeterContributions {
  greeting: String
}

@plugin_point(version = "1.1", contributions = GreeterContributions, allows(Secrets, Net))
pub interface Greeter {
  func greet(name: in String): Result[String, String]
  func secret(key: in String): Result[String, String]
  func peek(key: in String): Result[String, String]
  func describe(round: in Bool): Result[String, String]
  func fetch(): Result[String, String]
  func shape(round: in Bool): Result[Shape, String]
  func tally(words: in List[String]): Result[Map[String, Int], String]
  func total(scores: in Map[String, Int]): Result[Int, String]
  func count(): Result[Int, String]
  func crash(): Result[String, String]
  func spin(): Result[String, String]
  func hog(megabytes: in Int): Result[Int, String]
}

// ── The plugin ──────────────────────────────────────────────────────────────
@plugin(id = "lyric.test.greeter-component", version = "1.0.0", publisher = "lyric", implements(Greeter))
pub ref record GreeterPlugin {
  secrets: SecretsClient
  net: Option[NetClient]
  var calls: Int = 0
}

func callErrorText(e: in CallError[String]): String {
  match e {
    case CallError.App(m) -> m
    case CallError.Boundary(b) -> "boundary: " + boundaryErrorMessage(b)
  }
}

impl Greeter for GreeterPlugin {
  func greet(name: in String): Result[String, String] {
    Ok(value = "hello, " + name)
  }

  func secret(key: in String): Result[String, String] {
    match secrets.read(key) {
      case Ok(v) -> Ok(value = v)
      case Err(e) -> Err(error = callErrorText(e))
    }
  }

  func peek(key: in String): Result[String, String] {
    match secrets.peek(key) {
      case Ok(b) -> Ok(value = if b { "visible" } else { "hidden" })
      case Err(CallError.App(_)) -> Err(error = "app: no such key")
      case Err(CallError.Boundary(b)) -> Err(error = "boundary: " + boundaryErrorMessage(b))
    }
  }

  func describe(round: in Bool): Result[String, String] {
    val shape = if round { Shape.Circle(radius = 1.5) } else { Shape.Named(label = "tri") }
    val tags: Map[String, Int] = newMap()
    tags.add("sides", if round { 0 } else { 3 })
    match secrets.describe(shape, tags) {
      case Ok(v) -> Ok(value = v)
      case Err(e) -> Err(error = callErrorText(e))
    }
  }

  func fetch(): Result[String, String] {
    match net {
      case None -> Err(error = "net is not granted")
      case Some(n) -> match n.fetch("https://example.com") {
        case Ok(v) -> Ok(value = v)
        case Err(e) -> Err(error = callErrorText(e))
      }
    }
  }

  func shape(round: in Bool): Result[Shape, String] {
    if round {
      Ok(value = Shape.Circle(radius = 2.5))
    } else {
      Ok(value = Shape.Named(label = "square"))
    }
  }

  func tally(words: in List[String]): Result[Map[String, Int], String] {
    val acc: Map[String, Int] = newMap()
    for w in words {
      if isNone(mapGet(acc, w)) {
        var n = 0
        for x in words {
          if x == w {
            n = n + 1
          }
        }
        acc.add(w, n)
      }
    }
    Ok(value = acc)
  }

  func total(scores: in Map[String, Int]): Result[Int, String] {
    var sum = 0
    for k in mapKeys(scores) {
      match mapGet(scores, k) {
        case Some(n) -> {
          sum = sum + n
        }
        case None -> ()
      }
    }
    Ok(value = sum)
  }

  func count(): Result[Int, String] {
    self.calls = self.calls + 1
    Ok(value = self.calls)
  }

  func crash(): Result[String, String] {
    panic("greeter_component: crashing on request")
  }

  // Never yields and never returns: only the host's epoch deadline stops it.
  func spin(): Result[String, String] {
    var n = 0
    while n != -1 {
      n = (n + 7) % 1000003
    }
    Ok(value = "unreachable")
  }

  // Grows a string to at least `megabytes` MiB.
  func hog(megabytes: in Int): Result[Int, String] {
    var s = "0123456789abcdef"
    while s.length < megabytes * 1048576 {
      s = s + s
    }
    Ok(value = s.length / 1048576)
  }
}

@plugin_contributions(Greeter)
func greeterContributions(): GreeterContributions {
  GreeterContributions(greeting = "hello")
}

@plugin_request(Secrets)
func secretsRequest(): SecretsGrant {
  val keys: List[String] = newList()
  keys.add("alpha")
  keys.add("beta")
  SecretsGrant(keys = keys)
}
