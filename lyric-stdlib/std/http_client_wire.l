//! std/http_client_wire.l — pure-Lyric, sans-IO HTTP/1.1 client wire codec
//! (#8560).
//!
//! `Std.HttpEngine` is the *server* half of HTTP/1.1 (request parser,
//! response serializer). This module is the client half: it serializes a
//! request and parses a response from bytes a transport hands it, and never
//! touches a socket. It exists so a target whose HTTP stack has no
//! Unix-domain-socket transport (the JVM: `java.net.http.HttpClient` cannot
//! use one) can drive the same protocol over any byte stream — the JVM kernel
//! (`_kernel_jvm/http_host.l`) supplies a `SocketChannel`, this file supplies
//! the framing.
//!
//! Scope: HTTP/1.1, one request per connection (every request carries
//! `Connection: close`), fully buffered responses — the same semantics
//! `Std.Http` documents for every target.
//!
//! ## Response framing (RFC 9112 §6)
//!
//!   - Interim `1xx` responses (except `101`) are skipped.
//!   - A response to `HEAD`, and any `1xx`/`204`/`304`, has no body.
//!   - `Transfer-Encoding: chunked` (as the last coding) is decoded; any other
//!     transfer coding is `Malformed`.
//!   - `Content-Length` frames the body; repeated values must agree.
//!   - A message carrying both `Transfer-Encoding` and `Content-Length` is
//!     `Malformed` (request-smuggling guard, RFC 9112 §6.1).
//!   - Otherwise the body runs to the end of the connection, so the response
//!     is `Incomplete` until the caller reports `atEof`.
//!
//! `parseClientResponse` is a pure function of the bytes received so far:
//! a transport appends what it reads and re-parses until the result is no
//! longer `Incomplete`.
package Std.HttpClientWire

import Std.Core
import Std.Collections
import Std.String
import Std.Encoding
import Std.HttpEngine

/// Longest status line plus header block accepted before the response is
/// refused as `Malformed` (matches `EngineLimits` order of magnitude).
pub val MAX_RESPONSE_HEAD_BYTES: Int = 65536

/// A parsed response. `headers` keeps wire order and the sender's case.
pub record ClientResponse {
  status: Int
  reason: String
  headers: List[HeaderField]
  body: slice[Byte]
}

/// Result of parsing the bytes received so far.
pub union ClientParse {
  case Incomplete
  case Complete(response: ClientResponse)
  case Malformed(message: String)
}

// ─── Request serialization ──────────────────────────────────────────────────
func isCtlOrSpace(b: in Byte): Bool {
  val c = b.toInt()
  c <= 32 or c == 127
}

func hasBytesBelow32(s: in String): Bool {
  val bytes = encodeUtf8(s)
  var i = 0
  while i < bytes.length {
    val c = bytes[i].toInt()
    if (c < 32 and c != 9) or c == 127 {
      return true
    }
    i = i + 1
  }
  false
}

func hasCtlOrSpace(s: in String): Bool {
  val bytes = encodeUtf8(s)
  var i = 0
  while i < bytes.length {
    if isCtlOrSpace(bytes[i]) {
      return true
    }
    i = i + 1
  }
  false
}

/// Serialize an HTTP/1.1 request. `contentType` is sent only when `body` is
/// `Some`; `Content-Length` is derived from the body (an empty body on a
/// method that conventionally carries one still sends `Content-Length: 0`).
/// `Host` and `Connection: close` are always generated, so a caller-supplied
/// header of either name (or of `Content-Length`) is rejected rather than
/// duplicated.
///
/// Returns `Err` for a method that is not an RFC 9110 token, a target with
/// whitespace or control bytes, or a header name/value that could split the
/// message (CR, LF, NUL and other control bytes), never a malformed request.
@pure
@experimental
pub func serializeClientRequest(
  method: in String,
  target: in String,
  host: in String,
  headers: in List[HeaderField],
  contentType: in String,
  body: in Option[slice[Byte]],
): Result[slice[Byte], String] {
  if not isFieldNameToken(method) {
    return Err(error = "invalid HTTP method: " + method)
  }
  if target.length == 0 or hasCtlOrSpace(target) {
    return Err(error = "invalid request target")
  }
  if host.length == 0 or hasCtlOrSpace(host) {
    return Err(error = "invalid Host value")
  }
  var text = method + " " + target + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n"
  var i = 0
  while i < headers.count {
    val h = headers[i]
    if not isFieldNameToken(h.name) {
      return Err(error = "invalid header name: " + h.name)
    }
    if hasBytesBelow32(h.value) {
      return Err(error = "invalid header value for " + h.name)
    }
    val lower = h.name.toLower()
    if lower == "host" or lower == "connection" or lower == "content-length" or lower == "transfer-encoding" {
      return Err(error = "header is generated by the client: " + h.name)
    }
    text = text + h.name + ": " + h.value + "\r\n"
    i = i + 1
  }
  match body {
    case Some(bytes) -> {
      if hasBytesBelow32(contentType) {
        return Err(error = "invalid Content-Type value")
      }
      if contentType.length > 0 {
        text = text + "Content-Type: " + contentType + "\r\n"
      }
      text = text + "Content-Length: " + bytes.length.toString() + "\r\n\r\n"
      return Ok(value = encodeUtf8(text).concat(bytes))
    }
    case None -> {
      val lower = method.toUpper()
      if lower == "POST" or lower == "PUT" or lower == "PATCH" {
        text = text + "Content-Length: 0\r\n"
      }
      return Ok(value = encodeUtf8(text + "\r\n"))
    }
  }
}

// ─── Response parsing ───────────────────────────────────────────────────────
// Bytes are mapped one-to-one onto code points (ISO-8859-1), the JDK's own
// header decoding: header text is a byte string in RFC 9110, not Unicode.
func latin1(bytes: in slice[Byte]): String {
  var acc = ""
  var i = 0
  while i < bytes.length {
    acc = acc + codepointToString(bytes[i].toInt())
    i = i + 1
  }
  acc
}

/// Index of the first CRLF CRLF at or after `from`, or -1.
func findHeadEnd(buf: in slice[Byte], from: in Int): Int {
  var i = from
  while i + 3 < buf.length {
    if buf[i].toInt() == 13 and buf[i + 1].toInt() == 10 and buf[i + 2].toInt() == 13 and buf[i + 3].toInt() == 10 {
      return i
    }
    i = i + 1
  }
  -1
}

/// Index of the first CRLF at or after `from`, or -1.
func findCrlf(buf: in slice[Byte], from: in Int): Int {
  var i = from
  while i + 1 < buf.length {
    if buf[i].toInt() == 13 and buf[i + 1].toInt() == 10 {
      return i
    }
    i = i + 1
  }
  -1
}

func isDigitByte(b: in Byte): Bool {
  val c = b.toInt()
  c >= 48 and c <= 57
}

/// Decimal digits only, at most 9 (so the value fits an `Int` with room for
/// the body-length arithmetic below); `-1` otherwise.
func parseDecimal(text: in String): Int {
  val bytes = encodeUtf8(text)
  if bytes.length == 0 or bytes.length > 9 {
    return -1
  }
  var n = 0
  var i = 0
  while i < bytes.length {
    if not isDigitByte(bytes[i]) {
      return -1
    }
    n = n * 10 + (bytes[i].toInt() - 48)
    i = i + 1
  }
  n
}

func hexDigitValue(b: in Byte): Int {
  val c = b.toInt()
  if c >= 48 and c <= 57 {
    c - 48
  } else if c >= 97 and c <= 102 {
    c - 87
  } else if c >= 65 and c <= 70 {
    c - 55
  } else {
    -1
  }
}

/// Chunk-size line: hex digits (at most 7, so below 2^28) optionally followed
/// by `;extension`. `-1` if malformed.
func parseChunkSize(line: in slice[Byte]): Int {
  var n = 0
  var digits = 0
  var i = 0
  var inExtension = false
  while i < line.length and not inExtension {
    val b = line[i]
    if b.toInt() == 59 {
      inExtension = true
    } else {
      val d = hexDigitValue(b)
      if d < 0 {
        return -1
      }
      n = n * 16 + d
      digits = digits + 1
      if digits > 7 {
        return -1
      }
      i = i + 1
    }
  }
  if digits == 0 {
    -1
  } else {
    n
  }
}

union HeadParse {
  case HeadMalformed(message: String)
  case HeadOk(status: Int, reason: String, headers: List[HeaderField])
}

func parseHead(head: in slice[Byte]): HeadParse {
  val firstEnd = findCrlf(head, 0)
  val statusLineEnd = if firstEnd < 0 { head.length } else { firstEnd }
  val statusLine = latin1(head.slice(0, statusLineEnd))
  if statusLine.length < 12 or statusLine.substring(0, 5) != "HTTP/" {
    return HeadMalformed(message = "malformed status line")
  }
  val minor = statusLine.substring(5, 3)
  if minor != "1.1" and minor != "1.0" {
    return HeadMalformed(message = "unsupported HTTP version: " + minor)
  }
  if statusLine.substring(8, 1) != " " {
    return HeadMalformed(message = "malformed status line")
  }
  val status = parseDecimal(statusLine.substring(9, 3))
  if status < 100 or status > 599 {
    return HeadMalformed(message = "malformed status code")
  }
  if statusLine.length > 12 and statusLine.substring(12, 1) != " " {
    return HeadMalformed(message = "malformed status line")
  }
  val reason = if statusLine.length > 13 { statusLine.substring(13) } else { "" }

  val headers: List[HeaderField] = newList()
  var pos = if firstEnd < 0 { head.length } else { firstEnd + 2 }
  while pos < head.length {
    val lineEnd = findCrlf(head, pos)
    val stop = if lineEnd < 0 { head.length } else { lineEnd }
    val line = head.slice(pos, stop)
    var colon = -1
    var j = 0
    while j < line.length and colon < 0 {
      if line[j].toInt() == 58 {
        colon = j
      }
      j = j + 1
    }
    if colon <= 0 {
      return HeadMalformed(message = "malformed header line")
    }
    val name = latin1(line.slice(0, colon))
    if not isFieldNameToken(name) {
      return HeadMalformed(message = "invalid header name")
    }
    var vs = colon + 1
    var ve = line.length
    while vs < ve and (line[vs].toInt() == 32 or line[vs].toInt() == 9) {
      vs = vs + 1
    }
    while ve > vs and (line[ve - 1].toInt() == 32 or line[ve - 1].toInt() == 9) {
      ve = ve - 1
    }
    headers.add(HeaderField(name = name, value = latin1(line.slice(vs, ve))))
    pos = stop + 2
  }
  HeadOk(status = status, reason = reason, headers = headers)
}

union BodyParse {
  case BodyIncomplete
  case BodyMalformed(message: String)
  case BodyOk(body: slice[Byte])
}

func decodeChunked(buf: in slice[Byte], start: in Int): BodyParse {
  var pos = start
  var acc: slice[Byte] = []
  while true {
    val lineEnd = findCrlf(buf, pos)
    if lineEnd < 0 {
      if buf.length - pos > 1024 {
        return BodyMalformed(message = "chunk-size line too long")
      }
      return BodyIncomplete
    }
    val size = parseChunkSize(buf.slice(pos, lineEnd))
    if size < 0 {
      return BodyMalformed(message = "malformed chunk size")
    }
    pos = lineEnd + 2
    if size == 0 {
      // Trailer section: header lines up to the empty line, discarded.
      while true {
        val tEnd = findCrlf(buf, pos)
        if tEnd < 0 {
          return BodyIncomplete
        }
        if tEnd == pos {
          return BodyOk(body = acc)
        }
        pos = tEnd + 2
      }
    }
    if buf.length < pos + size + 2 {
      return BodyIncomplete
    }
    if buf[pos + size].toInt() != 13 or buf[pos + size + 1].toInt() != 10 {
      return BodyMalformed(message = "chunk data is not followed by CRLF")
    }
    acc = acc.concat(buf.slice(pos, pos + size))
    pos = pos + size + 2
  }
  BodyIncomplete
}

func bodyForbidden(status: in Int, headRequest: in Bool): Bool {
  headRequest or status == 204 or status == 304 or (status >= 100 and status < 200)
}

/// Parse the response in `buf` (everything received so far). `headRequest` is
/// true when the request was `HEAD`; `atEof` is true once the peer has closed
/// the connection, which is what ends a body that has no length framing.
@pure
@experimental
pub func parseClientResponse(buf: in slice[Byte], headRequest: in Bool, atEof: in Bool): ClientParse {
  var offset = 0
  while true {
    val rest = buf.slice(offset, buf.length)
    val headEnd = findHeadEnd(rest, 0)
    if headEnd < 0 {
      if rest.length > MAX_RESPONSE_HEAD_BYTES {
        return Malformed(message = "response head exceeds " + MAX_RESPONSE_HEAD_BYTES.toString() + " bytes")
      }
      if atEof {
        return Malformed(message = "connection closed before the response head was complete")
      }
      return Incomplete
    }
    if headEnd > MAX_RESPONSE_HEAD_BYTES {
      return Malformed(message = "response head exceeds " + MAX_RESPONSE_HEAD_BYTES.toString() + " bytes")
    }
    val parsed = parseHead(rest.slice(0, headEnd))
    match parsed {
      case HeadMalformed(message) -> return Malformed(message = message)
      case HeadOk(status, reason, headers) -> {
        val bodyStart = headEnd + 4
        if status >= 100 and status < 200 and status != 101 {
          offset = offset + bodyStart
        } else {
          return finishResponse(rest, bodyStart, status, reason, headers, headRequest, atEof)
        }
      }
    }
  }
  Incomplete
}

func finishResponse(
  rest: in slice[Byte],
  bodyStart: in Int,
  status: in Int,
  reason: in String,
  headers: in List[HeaderField],
  headRequest: in Bool,
  atEof: in Bool,
): ClientParse {
  if bodyForbidden(status, headRequest) {
    return Complete(response = ClientResponse(status = status, reason = reason, headers = headers, body = []))
  }
  val te = headerValues(headers, "Transfer-Encoding")
  val cl = headerValues(headers, "Content-Length")
  if te.count > 0 and cl.count > 0 {
    return Malformed(message = "response carries both Transfer-Encoding and Content-Length")
  }
  if te.count > 0 {
    var last = te[te.count - 1].toLower().trim()
    val comma = lastIndexOf(last, ",")
    match comma {
      case Some(idx) -> {
        last = last.substring(idx + 1).trim()
      }
      case None -> ()
    }
    if last != "chunked" {
      return Malformed(message = "unsupported transfer coding: " + last)
    }
    match decodeChunked(rest, bodyStart) {
      case BodyIncomplete -> {
        if atEof {
          return Malformed(message = "connection closed inside a chunked body")
        }
        return Incomplete
      }
      case BodyMalformed(message) -> return Malformed(message = message)
      case BodyOk(body) -> return Complete(response = ClientResponse(status = status, reason = reason, headers = headers, body = body))
    }
  }
  if cl.count > 0 {
    val first = parseDecimal(cl[0].trim())
    if first < 0 {
      return Malformed(message = "invalid Content-Length")
    }
    var i = 1
    while i < cl.count {
      if parseDecimal(cl[i].trim()) != first {
        return Malformed(message = "conflicting Content-Length values")
      }
      i = i + 1
    }
    if rest.length - bodyStart < first {
      if atEof {
        return Malformed(message = "connection closed before the response body was complete")
      }
      return Incomplete
    }
    return Complete(
      response = ClientResponse(
        status = status,
        reason = reason,
        headers = headers,
        body = rest.slice(bodyStart, bodyStart + first)
      )
    )
  }
  if not atEof {
    return Incomplete
  }
  Complete(
    response = ClientResponse(
      status = status,
      reason = reason,
      headers = headers,
      body = rest.slice(bodyStart, rest.length)
    )
  )
}
